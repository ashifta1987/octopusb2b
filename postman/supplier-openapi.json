    "/quotes": {
      "post": {
        "tags": [
          "RFQs & quotes"
        ],
        "summary": "Quote an assigned RFQ",
        "operationId": "postQuotes",
        "security": [
          {
            "oauth2": [
              "quotes:write"
            ]
          },
          {
            "apiKey": []
          }
        ],
        "description": "Scopes (any of): quotes:write",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "Unique key per logical request (e.g. a UUID). Replays return the stored response.",
            "schema": {
              "type": "string",
              "maxLength": 255
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "rfq_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "unit_price": {
                    "type": "object",
                    "properties": {
                      "amount_minor": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991,
                        "description": "Integer minor units (cents / fen) of `currency`"
                      },
                      "currency": {
                        "type": "string",
                        "enum": [
                          "USD",
                          "CNY"
                        ]
                      }
                    },
                    "required": [
                      "amount_minor",
                      "currency"
                    ]
                  },
                  "quantity": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "incoterm": {
                    "type": "string",
                    "enum": [
                      "EXW",
                      "FOB",
                      "CIF",
                      "CFR",
                      "DAP",
                      "DDP",
                      "FCA"
                    ]
                  },
                  "lead_time_days": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "shipping": {
                    "type": "object",
                    "properties": {
                      "amount_minor": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991,
                        "description": "Integer minor units (cents / fen) of `currency`"
                      },
                      "currency": {
                        "type": "string",
                        "enum": [
                          "USD",
                          "CNY"
                        ]
                      }
                    },
                    "required": [
                      "amount_minor",
                      "currency"
                    ]
                  },
                  "notes": {
                    "type": "string",
                    "maxLength": 2000
                  }
                },
                "required": [
                  "rfq_id",
                  "unit_price",
                  "quantity",
                  "incoterm",
                  "lead_time_days"
                ]
              },
              "example": {
                "rfq_id": "3f0c1a52-8f5e-4c6b-9b7a-2d1e0f9a8b7c",
                "unit_price": {
                  "amount_minor": 620,
                  "currency": "CNY"
                },
                "quantity": 5000,
                "incoterm": "FOB",
                "lead_time_days": 25,
                "shipping": {
                  "amount_minor": 180000,
                  "currency": "CNY"
                },
                "notes": "EN 388 certified"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SupplierQuoteEnvelope"
                }
              }
            }
          },
