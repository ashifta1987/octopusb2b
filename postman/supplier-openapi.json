                  "type": "integer"
                }
              }
            }
          },
          "501": {
            "description": "Endpoint not implemented yet (coming soon)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
