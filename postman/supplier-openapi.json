      "post": {
        "tags": [
          "Products"
        ],
        "summary": "Bulk upsert products by SKU (goes to moderation)",
        "operationId": "postProducts",
        "security": [
          {
            "oauth2": [
              "products:write"
            ]
          },
          {
            "apiKey": []
          }
        ],
        "description": "Scopes (any of): products:write",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "Unique key per logical request (e.g. a UUID). Replays return the stored response.",
            "schema": {
              "type": "string",
              "maxLength": 255
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "products": {
                    "minItems": 1,
                    "maxItems": 500,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "sku": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80,
                          "description": "Your own SKU — the upsert key"
                        },
                        "title": {
                          "type": "string",
                          "minLength": 3,
                          "maxLength": 200
                        },
                        "description": {
                          "type": "string",
                          "maxLength": 10000
                        },
                        "category_id": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                        },
                        "unit": {
                          "default": "pcs",
                          "type": "string",
                          "maxLength": 20
                        },
                        "moq": {
                          "default": 1,
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "lead_time_days": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "origin_country": {
                          "type": "string",
                          "minLength": 2,
                          "maxLength": 2
                        },
                        "hs_code": {
                          "type": "string",
                          "maxLength": 12
                        },
                        "price_tiers": {
                          "minItems": 1,
                          "maxItems": 10,
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "min_qty": {
                                "type": "integer",
                                "exclusiveMinimum": 0,
                                "maximum": 9007199254740991
                              },
                              "unit_price": {
                                "type": "object",
                                "properties": {
                                  "amount_minor": {
                                    "type": "integer",
                                    "minimum": -9007199254740991,
                                    "maximum": 9007199254740991,
                                    "description": "Integer minor units (cents / fen) of `currency`"
                                  },
                                  "currency": {
                                    "type": "string",
                                    "enum": [
                                      "USD",
                                      "CNY"
                                    ]
                                  }
                                },
                                "required": [
                                  "amount_minor",
                                  "currency"
                                ]
                              }
                            },
                            "required": [
                              "min_qty",
                              "unit_price"
                            ]
                          },
                          "description": "All tiers must use the same currency (USD or CNY)"
                        }
                      },
                      "required": [
                        "sku",
                        "title",
                        "price_tiers"
                      ]
                    }
                  }
                },
                "required": [
                  "products"
                ]
              },
              "example": {
                "products": [
                  {
                    "sku": "GLV-NIT-L",
                    "title": "Nitrile-coated work gloves, size L",
                    "unit": "pairs",
                    "moq": 1000,
                    "lead_time_days": 20,
                    "origin_country": "CN",
                    "hs_code": "611610",
                    "price_tiers": [
                      {
                        "min_qty": 1000,
                        "unit_price": {
                          "amount_minor": 650,
                          "currency": "CNY"
                        }
                      },
                      {
                        "min_qty": 5000,
                        "unit_price": {
                          "amount_minor": 580,
                          "currency": "CNY"
                        }
                      }
                    ]
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SupplierSyncResult"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
