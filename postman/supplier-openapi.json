            "description": "Insufficient scope or KYC required for live keys",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited (60/min per key)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "501": {
            "description": "Endpoint not implemented yet (coming soon)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/oauth/token": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Get an access token (OAuth 2 client credentials, 1 hour)",
        "operationId": "postOauthToken",
        "security": [],
        "servers": [
          {
            "url": "https://octopusb2b.com/api/v1"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "grant_type",
                  "client_id",
                  "client_secret"
                ],
                "properties": {
                  "grant_type": {
                    "const": "client_credentials"
                  },
                  "client_id": {
                    "type": "string",
                    "example": "cli_0123456789abcdef"
                  },
                  "client_secret": {
                    "type": "string",
                    "description": "An API key of this client: oct_test_… or oct_live_…"
                  },
                  "scope": {
                    "type": "string",
                    "description": "Space-separated subset of the client scopes"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "access_token",
                    "token_type",
                    "expires_in"
                  ],
                  "properties": {
                    "access_token": {
                      "type": "string"
                    },
                    "token_type": {
                      "const": "Bearer"
                    },
                    "expires_in": {
                      "type": "integer",
                      "example": 3600
                    },
                    "scope": {
                      "type": "string"
                    },
                    "mode": {
                      "enum": [
                        "test",
                        "live"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "invalid_request / invalid_scope",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "invalid_client",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://octopusb2b.com/api/v1/oauth/token",
            "scopes": {
              "products:write": "products:write",
              "inventory:write": "inventory:write",
              "rfqs:read": "rfqs:read",
              "quotes:write": "quotes:write",
              "orders:read": "orders:read"
            }
          }
        }
      },
      "apiKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "Supplier API key used directly as bearer token"
      }
    },
    "schemas": {
      "Amount": {
        "type": "object",
        "properties": {
          "amount_minor": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Integer minor units (cents / fen) of `currency`"
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD",
              "CNY"
            ]
          }
        },
        "required": [
          "amount_minor",
          "currency"
        ],
        "description": "Every amount in the API: integer minor units + ISO 4217 currency (USD or CNY)."
      },
      "Price": {
        "type": "object",
        "properties": {
          "amount_minor": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Integer minor units (cents / fen) of `currency`"
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD",
              "CNY"
            ]
          },
          "converted": {
            "type": "object",
            "properties": {
              "amount_minor": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991,
                "description": "Integer minor units (cents / fen) of `currency`"
              },
              "currency": {
                "type": "string",
                "enum": [
                  "USD",
                  "CNY"
                ]
              },
              "fx_rate_id": {
                "description": "Approved fx_rates row used for the conversion",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "amount_minor",
              "currency",
              "fx_rate_id"
            ],
            "description": "The price in the platform currency at the approved rate (equal to the original when the currencies match)"
          }
        },
        "required": [
          "amount_minor",
          "currency",
          "converted"
        ],
        "description": "A catalogue price in the currency it was entered in, plus `converted` into the platform currency at the approved rate."
      },
      "CurrencySettings": {
        "type": "object",
        "properties": {
          "currency": {
            "type": "string",
            "enum": [
              "USD",
              "CNY"
            ],
            "description": "Active platform currency — new quotes, invoices and charges use it"
          },
          "rate": {
            "type": "object",
            "properties": {
              "base": {
                "type": "string",
                "const": "USD"
              },
              "quote": {
                "type": "string",
                "const": "CNY"
              },
              "rate": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "CNY per 1 USD (approved billing rate)"
              },
              "effective_from": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "fx_rate_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "base",
              "quote",
              "rate",
              "effective_from",
              "fx_rate_id"
            ]
          }
        },
        "required": [
          "currency",
          "rate"
        ]
      },
      "Problem": {
        "type": "object",
        "description": "RFC 7807 problem details",
        "required": [
          "status",
          "code"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "PageMeta": {
        "type": "object",
        "required": [
          "page",
          "per_page",
          "total"
        ],
        "properties": {
          "page": {
            "type": "integer"
          },
          "per_page": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "total_pages": {
            "type": "integer"
          }
        }
      },
      "SupplierProduct": {
        "type": "object",
        "required": [
          "id",
          "title",
          "status",
          "currency"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "sku": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD",
              "CNY"
            ],
            "description": "Currency the record is locked in"
          },
          "price_tiers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "min_qty",
                "unit_price"
              ],
              "properties": {
                "min_qty": {
                  "type": "integer"
                },
                "unit_price": {
                  "$ref": "#/components/schemas/Amount"
                }
              }
            }
          },
          "updated_at": {
            "type": "string",
            "description": "ISO 8601 timestamp"
          }
        }
      },
      "SupplierSyncResult": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "accepted",
              "rejected"
            ],
            "properties": {
              "accepted": {
                "type": "integer"
              },
              "rejected": {
                "type": "integer"
              },
              "errors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "sku": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "SupplierRfq": {
        "type": "object",
        "required": [
          "id",
          "code",
          "title",
          "quantity",
          "currency"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "quantity": {
            "type": "integer"
          },
          "unit": {
            "type": "string"
          },
          "incoterm": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "destination_country": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD",
              "CNY"
            ],
            "description": "Currency the record is locked in"
          },
          "target_price": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Amount"
              },
              {
                "type": "null"
              }
            ]
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string",
                "description": "ISO 8601 timestamp"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "SupplierQuote": {
        "type": "object",
        "required": [
          "id",
          "code",
          "rfq_id",
          "currency",
          "unit_price",
          "total"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "rfq_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD",
              "CNY"
            ],
            "description": "Currency the record is locked in"
          },
          "unit_price": {
            "$ref": "#/components/schemas/Amount"
          },
          "shipping": {
            "$ref": "#/components/schemas/Amount"
          },
          "total": {
            "$ref": "#/components/schemas/Amount"
          },
          "valid_until": {
            "type": "string",
            "description": "ISO 8601 timestamp"
          }
        }
      },
      "SupplierOrder": {
        "type": "object",
        "required": [
          "id",
          "code",
          "status",
          "currency",
          "total"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "quantity": {
            "type": "integer"
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD",
              "CNY"
            ],
            "description": "Currency the record is locked in"
          },
          "total": {
            "$ref": "#/components/schemas/Amount"
          },
          "created_at": {
            "type": "string",
            "description": "ISO 8601 timestamp"
          }
        }
      },
      "SupplierProductList": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SupplierProduct"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/PageMeta"
          }
        }
      },
      "SupplierRfqList": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SupplierRfq"
            }
          }
        }
      },
      "SupplierQuoteEnvelope": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/SupplierQuote"
          },
          "simulated": {
            "type": "boolean",
            "description": "true when a test key was used — nothing was written"
          }
        }
      },
      "SupplierOrderList": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SupplierOrder"
            }
          }
        }
      }
    }
  }
}
