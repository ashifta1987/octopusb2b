{
  "openapi": "3.1.0",
  "info": {
    "title": "Octopus B2B Supplier API",
    "version": "1.0.0-beta",
    "description": "Bulk product sync, stock and price updates and quoting from your own ERP. Writes still pass moderation and the supplier switches.\n\n* **Status:** returns `403 SUPPLIER_PORTAL_DISABLED` until the supplier portal opens; endpoints then roll out (`501` until available).\n* **Auth:** same OAuth 2 client credentials as the public API (`POST /api/v1/oauth/token`) with supplier scopes.\n* **Money:** every amount is `{ \"amount_minor\": 19000, \"currency\": \"USD\" }` (minor units = cents / fen). Prices may be entered in USD or CNY (1688 suppliers often quote CNY). Quotes, orders, invoices and service requests keep the currency they were created in; catalogue prices keep the supplier's currency and add a `converted` amount in the platform currency. `GET /settings/currency` returns the platform currency (USD or CNY) and the approved rate; the `settings.currency_changed` webhook announces a switch.",
    "contact": {
      "name": "Octopus B2B",
      "email": "support@octopusb2b.com",
      "url": "https://octopusb2b.com"
    }
  },
  "servers": [
    {
      "url": "https://octopusb2b.com/api/supplier/v1",
      "description": "This deployment"
    },
    {
      "url": "https://api.octopusb2b.com/supplier/v1",
      "description": "Production"
    }
  ],
  "tags": [
    {
      "name": "Auth"
    },
    {
      "name": "Products"
    },
    {
      "name": "Inventory"
    },
    {
      "name": "RFQs & quotes"
    },
    {
      "name": "Orders"
    }
  ],
