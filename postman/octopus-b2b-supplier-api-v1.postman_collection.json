                  "var body = null;",
                  "try { body = text ? JSON.parse(text) : null; } catch (e) { body = null; }",
                  "if (pm.response.code === 200) {",
                  "  var schema = {\"type\":\"object\",\"required\":[\"data\"],\"properties\":{\"data\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"required\":[\"id\",\"title\",\"status\",\"currency\"],\"properties\":{\"id\":{\"type\":\"string\"},\"sku\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"title\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"currency\":{\"type\":\"string\",\"enum\":[\"USD\",\"CNY\"]},\"price_tiers\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"required\":[\"min_qty\",\"unit_price\"],\"properties\":{\"min_qty\":{\"type\":\"integer\"},\"unit_price\":{\"type\":\"object\",\"properties\":{\"amount_minor\":{\"type\":\"integer\",\"minimum\":-9007199254740991,\"maximum\":9007199254740991},\"currency\":{\"type\":\"string\",\"enum\":[\"USD\",\"CNY\"]}},\"required\":[\"amount_minor\",\"currency\"]}}}},\"updated_at\":{\"type\":\"string\"}}}},\"meta\":{\"type\":\"object\",\"required\":[\"page\",\"per_page\",\"total\"],\"properties\":{\"page\":{\"type\":\"integer\"},\"per_page\":{\"type\":\"integer\"},\"total\":{\"type\":\"integer\"},\"total_pages\":{\"type\":\"integer\"}}}}};",
                  "  pm.test('response matches the OpenAPI schema (SupplierProductList)', function () { pm.response.to.have.jsonSchema(schema); });",
                  "}",
                  "if ([403,501].indexOf(pm.response.code) !== -1) {",
                  "  var problemSchema = {\"type\":\"object\",\"required\":[\"status\",\"code\"],\"properties\":{\"type\":{\"type\":\"string\"},\"title\":{\"type\":\"string\"},\"status\":{\"type\":\"integer\"},\"code\":{\"type\":\"string\"},\"detail\":{\"type\":\"string\"},\"errors\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"}}}}}};",
                  "  pm.test('documented problem+json', function () { pm.response.to.have.jsonSchema(problemSchema); });",
                  "}",
                  "if (body !== null) {",
                  "  pm.test('every amount carries a currency', function () {",
                  "    var bad = [];",
                  "    (function walk(v, p) {",
                  "      if (Array.isArray(v)) { v.forEach(function (x, i) { walk(x, p + '[' + i + ']'); }); return; }",
                  "      if (!v || typeof v !== 'object') return;",
                  "      if (Object.prototype.hasOwnProperty.call(v, 'amount_minor') && !(typeof v.currency === 'string' && /^[A-Z]{3}$/.test(v.currency))) bad.push(p);",
                  "      Object.keys(v).forEach(function (k) { if (/_cents$/.test(k)) bad.push(p + '.' + k); walk(v[k], p + '.' + k); });",
